do_check() {
	if python3 -c 'import sys; raise SystemExit(sys.version_info >= (3, 14))'; then
		msg_warn "Tests skipped on Python >= 3.14 due to incompatible upstream tests"
		return 0
	fi
	PYTHONPATH="${wrksrc}/lib" python3 -m unittest discover -s tests
}

post_install() {
	vlicense LICENSE
}
