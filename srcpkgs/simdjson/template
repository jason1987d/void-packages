# Template file for 'simdjson'
pkgname=simdjson
version=5.1.1
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON"
short_desc="Parse gigabytes of JSON per second"
maintainer="Jason Elswick <jason@jasondavid.us>"
license="Apache-2.0 OR MIT"
homepage="https://github.com/simdjson/simdjson"
distfiles="https://github.com/simdjson/simdjson/archive/refs/tags/v${version}.tar.gz"
checksum=d669fa399613c20bbf7705f057a72984331b223cd5e8d20666ef063dbf97f3e6

post_install() {
	vlicense LICENSE-MIT
}

simdjson-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"

	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
	}
}
