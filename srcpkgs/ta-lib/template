# Template file for 'ta-lib'
pkgname=ta-lib
version=0.8.1
revision=1
build_style=cmake
short_desc="TA-Lib (Core C Library) (technical analysis)"
maintainer="Jason Elswick <jason@jasondavid.us>"
license="BSD-3-Clause"
homepage="https://github.com/TA-Lib/ta-lib"
changelog="https://github.com/TA-Lib/ta-lib/blob/main/CHANGELOG.md"
distfiles="https://github.com/TA-Lib/ta-lib/archive/refs/tags/v${version}.tar.gz"
checksum=b30f58c24587f5ac46abe7caded1b49c3e1639ca177f4f51079d4fe051a5fae1

post_install() {
	vlicense LICENSE
}

ta-lib-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/share
	}
}
