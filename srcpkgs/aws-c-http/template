revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON -DCMAKE_PREFIX_PATH=/usr"
makedepends="aws-c-cal-devel aws-c-common-devel aws-c-compression-devel aws-c-io-devel s2n-tls-devel openssl-devel"
short_desc="AWS C99 implementation of the HTTP/1.1 and HTTP/2 specifications"
