# Template file for 'aws-c-io'
pkgname=aws-c-io
version=1.1.0
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON -DCMAKE_PREFIX_PATH=/usr"
makedepends="aws-c-cal-devel aws-c-common-devel s2n-tls-devel openssl-devel"
