# Template file for 'aws-c-common'
pkgname=aws-c-common
version=1.0.0
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON"
short_desc="Core c99 package for AWS SDK for C"
maintainer="Jason Elswick <jason@jasondavid.us>"
license="Apache-2.0"
homepage="https://github.com/awslabs/aws-c-common"
distfiles="https://github.com/awslabs/aws-c-common/archive/refs/tags/v${version}.tar.gz"
checksum=94de89f65d4917dd7381679ea3297d7304c43338158fa7bec190fa53c218ce90

aws-c-common-devel_package() {
	depends="aws-c-common>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/*.so
	}
}
